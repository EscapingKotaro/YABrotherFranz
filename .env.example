# === Логирование ===
LOG_LEVEL=INFO

# === Тестовый режим ===
# Если true, все клиенты работают в режиме Mock
ENABLE_MOCK_MODE=true

# Гранулярные переключатели (имеют приоритет над ENABLE_MOCK_MODE)
MOCK_CNDK=true
MOCK_YANDEX=true
MOCK_CODE_API=true
MOCK_CRM=true

# === База данных ===
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/yandex_client

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === CNDK Posting API ===
CNDK_API_URL=https://sandbox.auto-posting.cyndykshop.su
CNDK_API_KEY=your_cndk_api_key_here

# === Code API ===
CODE_API_URL=https://ps.cyndykshop.su
CODE_API_APP_KEY=your_code_api_app_key
CODE_API_APP_SECRET=your_code_api_app_secret

# === CRM API ===
CRM_API_URL=https://chats.systemseller.net
CRM_API_KEY=your_crm_api_key_here
CRM_POLLING_INTERVAL=5
CRM_BATCH_SIZE=50

# === Яндекс Маркет (мульти-аккаунтность) ===
# JSON-массив конфигураций аккаунтов
YANDEX_ACCOUNTS_JSON=[
  {
    "campaign_id": "12345678",
    "business_id": "87654321",
    "api_key": "AQAAA..._MSK",
    "crm_marketplace_name": "yandex_msk_digital",
    "webhook_secret": "secret_msk"
  },
  {
    "campaign_id": "87654321",
    "business_id": "12345678",
    "api_key": "AQAAA..._SPB",
    "crm_marketplace_name": "yandex_spb_digital",
    "webhook_secret": "secret_spb"
  }
]

# === Портал активации ===
ACTIVATION_PORTAL_URL=https://systemseller.net/